{
  "name": "@agntn/archives",
  "version": "0.5.4",
  "description": "Unified interface for web archive providers",
  "keywords": [
    "agents",
    "archive",
    "archive-today",
    "arquivo",
    "arquivo-pt",
    "commoncrawl",
    "conifer",
    "history",
    "mcp",
    "memento",
    "memgator",
    "omp-extension",
    "permacc",
    "pi-extension",
    "pi-package",
    "wayback",
    "web-archive"
  ],
  "homepage": "https://archives.agntn.dev",
  "bugs": {
    "url": "https://github.com/agntn/archives/issues"
  },
  "license": "MIT",
  "author": "oritwoen",
  "repository": {
    "type": "git",
    "url": "https://github.com/agntn/archives"
  },
  "bin": {
    "archives": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "packages/pi/extensions",
    "packages/omp/extensions"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs",
      "default": "./dist/mcp.mjs"
    },
    "./tool-operations": {
      "types": "./dist/tool-operations.d.mts",
      "import": "./dist/tool-operations.mjs",
      "default": "./dist/tool-operations.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp test watch",
    "quality:prepare": "pnpm build && pnpm --dir playground exec nuxt prepare",
    "lint": "pnpm quality:prepare && vp lint && vp fmt --check",
    "lint:fix": "pnpm quality:prepare && vp lint --fix && vp fmt",
    "fmt": "pnpm quality:prepare && vp lint --fix && vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "pnpm lint && pnpm test:types && vp test run --coverage",
    "test:types": "pnpm build && tsc --noEmit --skipLibCheck && tsc --noEmit --skipLibCheck -p tsconfig.extensions.json",
    "build": "vp pack",
    "prepack": "pnpm build",
    "release": "pnpm test && changelogen --release --push",
    "docs": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "c12": "4.0.0-beta.5",
    "citty": "0.2.2",
    "consola": "3.4.2",
    "diff": "8.0.4",
    "ofetch": "1.5.1",
    "ohash": "2.0.11",
    "ufo": "1.6.4",
    "unstorage": "1.17.5"
  },
  "devDependencies": {
    "@agntn/ox": "^0.1.0",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "@oh-my-pi/omptype": "17.3.0",
    "@oh-my-pi/pi-coding-agent": "17.3.0",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "catalog:",
    "changelogen": "0.6.2",
    "typebox": "1.3.15",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "webmcp-types": "0.1.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "@earendil-works/pi-tui": "*",
    "@oh-my-pi/omptype": "*",
    "@oh-my-pi/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@oh-my-pi/omptype": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "resolutions": {
    "@agntn/archives": "link:."
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.8.1",
  "omp": {
    "extensions": [
      "./packages/omp/extensions/archives.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./packages/pi/extensions/*.ts"
    ]
  }
}
