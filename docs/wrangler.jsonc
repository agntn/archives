{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agntn-archives",
  "account_id": "6ef8d3cbe19975e93d994f25228488e7",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NUXT_SITE_URL": "https://archives.agntn.dev"
  },
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agntn-archives",
      "database_id": "14865f91-e069-4e3a-8970-29a9f43163b5"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "06c8056b5d1c4d8ca16b3969ff8fbb92"
    }
  ],
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "cache": {
    "enabled": true
  },
  "routes": [{ "pattern": "archives.agntn.dev", "custom_domain": true }]
}
